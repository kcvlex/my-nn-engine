  cudnnCheckErr(cudnnSetFilter4dDescriptor(setting.w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, 16, 8, 3, 3));
  cudnnCheckErr(cudnnCreateActivationDescriptor(&setting.activation_desc));
  cudnnCheckErr(cudnnSetActivationDescriptor(setting.activation_desc, CUDNN_ACTIVATION_IDENTITY, CUDNN_NOT_PROPAGATE_NAN, 0));
  cudnnCheckErr(cudnnCreateConvolutionDescriptor(&setting.conv_desc));
  cudnnCheckErr(cudnnSetConvolution2dDescriptor(setting.conv_desc, 1, 1, 1, 1, 1, 1, CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));
