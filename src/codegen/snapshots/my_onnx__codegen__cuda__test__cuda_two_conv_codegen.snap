void init_cudnn_1(CudnnConvSetting &setting, CudnnHandlerContext &cudnn_handler_ctx) {
  cudnnCheckErr(cudnnCreateTensorDescriptor(&setting.x_desc));
  cudnnCheckErr(cudnnSetTensor4dDescriptor(setting.x_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT, 1, 3, 16, 16));
  cudnnCheckErr(cudnnCreateTensorDescriptor(&setting.y_desc));
  cudnnCheckErr(cudnnSetTensor4dDescriptor(setting.y_desc, CUDNN_TENSOR_NHWC, CUDNN_DATA_FLOAT, 1, 8, 16, 16));
  cudnnCheckErr(cudnnCreateFilterDescriptor(&setting.w_desc));
  cudnnCheckErr(cudnnSetFilter4dDescriptor(setting.w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW, 8, 3, 3, 3));
  cudnnCheckErr(cudnnCreateActivationDescriptor(&setting.activation_desc));
  cudnnCheckErr(cudnnSetActivationDescriptor(setting.activation_desc, CUDNN_ACTIVATION_IDENTITY, CUDNN_NOT_PROPAGATE_NAN, 0));
  cudnnCheckErr(cudnnCreateConvolutionDescriptor(&setting.conv_desc));
  cudnnCheckErr(cudnnSetConvolution2dDescriptor(setting.conv_desc, 1, 1, 1, 1, 1, 1, CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));
  setting.find_best_algo(&cudnn_handler_ctx);
}
